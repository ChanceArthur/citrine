#!/bin/bash
. /usr/libexec/citrine/common

file=/etc/citrine/secrets.env
state=/var/lib/citrine
own=/usr/lib/citrine/secrets.conf
site=$state/site/$SITE_DIR

usage='usage: secrets list | set | restore | unset <key>'
[ "$(id -u)" = 0 ] || die "$usage"

umask 077
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

reserved=$(conf_reserved)

conf_named() { [ -z "$2" ] || echo "$2"; }

site_declares() {
  local f named=
  [ -d "$site" ] && [ -z "$(find "$site" -type l -print -quit)" ] || return 0
  [ ! -r "$site/citrine.conf" ] || named=$(conf_walk "$site/citrine.conf" conf_named | paste -sd'|' -)
  for f in "$site"/env/*; do
    [ -f "$f" ] || continue
    case ${f##*/} in cloudflared.env | dashboard.env) continue ;; esac
    echo
    awk -v skip="^($reserved${named:+|$named})\$" -v file="${f##*/}" '
      BEGIN { print "# env/" file }
      /^#/ { next }
      {
        line = $0
        while (match(line, /@[A-Z][A-Z0-9_]*@/)) {
          k = substr(line, RSTART + 1, RLENGTH - 2)
          if (k !~ skip) print k "="
          line = substr(line, RSTART + RLENGTH)
        }
      }' "$f"
  done
}

declared() {
  {
    cat "$own"
    site_declares
    echo
  } | awk '
    BEGIN { fresh = 1 }
    /^[[:space:]]*$/ { note = ""; fresh = 1; next }
    /^#/ { sub(/^#[ ]?/, ""); note = note (note == "" ? "" : " ") $0; fresh = 1; next }
    /^[A-Z][A-Z0-9_]*=/ {
      k = $0
      sub(/=.*/, "", k)
      if (seen[k]++) next
      if (fresh) { print "G " note; fresh = 0 }
      print "K " k
    }'
}

is_set() { [ -r "$file" ] && grep -q "^$1=" "$file"; }

list() {
  local kind rest stale
  declared >"$tmp/declared"
  while read -r kind rest; do
    if [ "$kind" = K ]; then
      if is_set "$rest"; then echo "K $rest set"; else echo "K $rest empty"; fi
    else
      echo "G $rest"
    fi
  done <"$tmp/declared"
  [ -r "$file" ] || return 0
  stale=$(sed -n 's/^\([A-Z][A-Z0-9_]*\)=.*/\1/p' "$file" | while read -r rest; do
    grep -qxF "K $rest" "$tmp/declared" || echo "K $rest set"
  done)
  [ -z "$stale" ] || printf 'G Nothing declares these any more.\n%s\n' "$stale"
}

without() {
  grep -v "^$1=" "$2" >"$2.next" || true
  mv "$2.next" "$2"
}

install_file() {
  install -d -m 0755 "${file%/*}"
  install -m 0600 "$1" "$file"
}

merge() {
  local next=$tmp/next line k v n=0
  declared >"$tmp/declared"
  : >"$next"
  [ ! -r "$file" ] || cat "$file" >"$next"
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    line=${line#"${line%%[![:space:]]*}"}
    case $line in '' | '#'*) continue ;; esac
    line=${line#export }
    k=${line%%=*}
    v=${line#*=}
    [[ $line == *=* && $k =~ ^[A-Z][A-Z0-9_]*$ ]] || die "line $n isn't KEY=value"
    grep -qxF "K $k" "$tmp/declared" ||
      die "neither Citrine nor the site's env/ asks for $k"
    [ -n "$v" ] || continue
    case $v in
      \'*\' | \"*\")
        v=${v#?}
        v=${v%?}
        ;;
    esac
    v=$(printf '%s\n' "$v" | sed "s/'/'\\\\''/g")
    without "$k" "$next"
    printf "%s='%s'\n" "$k" "$v" >>"$next"
  done
  install_file "$next"
}

after() {
  [ -e "$state/setup.done" ] || [ -e "$state/first-boot.done" ] || return 0
  /usr/libexec/citrine/site apply
  /usr/libexec/citrine/setup save || true
  systemctl start --no-block citrine-cloudflare.service
}

written_here() {
  local line re="^([A-Z][A-Z0-9_]*)='([^']|'\\\\'')*'\$"
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in '' | '#'*) continue ;; esac
    [[ $line =~ $re ]] || die "the backup's secrets.env has a line secrets never writes"
    [[ ! ${BASH_REMATCH[1]} =~ ^($reserved)$ ]] || grep -q "^${BASH_REMATCH[1]}=" "$own" ||
      die "the backup's secrets.env sets ${BASH_REMATCH[1]}, which no secret may"
  done <"$1"
}

restore() {
  local input=$tmp/input dump=$tmp/dump
  cat >"$input"
  merge <"$input"
  load /etc/citrine/citrine.conf "$file"
  r2_env
  restic dump --tag files latest "$file" >"$dump" ||
    die "the newest backup in that bucket has no secrets, or those keys can't open it"
  [ -s "$dump" ] || die "the secrets in the newest backup are empty"
  written_here "$dump"
  install_file "$dump"
  merge <"$input"
}

case ${1:-} in
  list) list ;;
  set)
    merge
    after
    ;;
  restore)
    restore
    after
    ;;
  unset)
    [[ ${2:-} =~ ^[A-Z][A-Z0-9_]*$ ]] || die "$usage"
    [ -r "$file" ] || exit 0
    cat "$file" >"$tmp/next"
    without "$2" "$tmp/next"
    install_file "$tmp/next"
    after
    ;;
  *) die "$usage" ;;
esac
