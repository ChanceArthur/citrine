[Unit]
Description=EmDash - Postgres

[Container]
Image=docker.io/library/postgres:18
ContainerName=emdash-postgres
AutoUpdate=registry
Network=emdash.network
EnvironmentFile=/etc/citrine/env/emdash-postgres.env
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Volume=/var/mnt/data/emdash/postgres:/var/lib/postgresql:Z
HealthCmd=pg_isready --dbname="$POSTGRES_DB" --username="$POSTGRES_USER"
HealthInterval=10s
HealthStartPeriod=30s
HealthRetries=5
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
